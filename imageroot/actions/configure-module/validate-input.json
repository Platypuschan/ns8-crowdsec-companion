{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "configure-module",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role"
  ],
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "hub",
        "member"
      ]
    },
    "hub_host": {
      "type": "string",
      "maxLength": 253
    },
    "lets_encrypt": {
      "type": "boolean"
    },
    "token": {
      "type": "string",
      "maxLength": 4096
    },
    "insecure_skip_verify": {
      "type": "boolean"
    },
    "ban_duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,4}(m|h)$"
    },
    "allowlist": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "samba_audit": {
      "type": "boolean"
    }
  }
}