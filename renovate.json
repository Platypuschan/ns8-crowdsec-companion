{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "dependencyDashboard": {"enabled": true},
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build-images\\.sh$/"
      ],
      "matchStrings": [
        "(?:crowdsec_image|bouncer_image)=\"(?<depName>docker\\.io/crowdsecurity/crowdsec|ghcr\\.io/nethserver/crowdsec-firewall-bouncer):(?<currentValue>[-0-9A-Za-z_.]+)(?:@(?<currentDigest>sha256:[a-fA-F0-9]{64}))?\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "CI actions are separate from setup-node version inputs",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action",
        "workflow",
        "github-runner"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group Docker short/full names and setup-node; Node 25+ needs a separate Corepack migration",
      "matchPackageNames": [
        "node",
        "docker.io/library/node",
        "actions/node-versions"
      ],
      "groupName": "Node.js toolchain",
      "allowedVersions": "<25"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "ui/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "UI dependencies (non-major)",
      "groupSlug": "ui-dependencies-non-major"
    },
    {
      "description": "All RELEASE_PATHS from check-catalog-version, including lockfile-only updates",
      "matchFileNames": [
        "imageroot/**",
        "ui/**",
        "build-images.sh"
      ],
      "bumpVersions": [
        {
          "name": "Module release version",
          "filePatterns": [
            "CATALOG_VERSION"
          ],
          "matchStrings": [
            "^(?<version>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)\\s*$"
          ],
          "bumpType": "patch"
        }
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
